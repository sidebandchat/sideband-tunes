{
  "name": "@sidebandchat/tunes",
  "version": "0.1.0",
  "description": "Observe system media sessions from Node.js and Electron",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "commonjs",
  "license": "GPL-3.0-only",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sidebandchat/sideband-tunes"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "native.js",
    "COPYRIGHT"
  ],
  "napi": {
    "binaryName": "sideband-tunes",
    "packageName": "@sidebandchat/tunes",
    "targets": [
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --js native.js --dts native.d.ts",
    "build:debug": "napi build --platform --js native.js --dts native.d.ts",
    "check": "cargo check --all-targets",
    "format": "cargo fmt && prettier --write index.js index.d.ts package.json README.md scripts/*.mjs .github/workflows/*.yml",
    "format:check": "cargo fmt --check && prettier --check index.js index.d.ts package.json README.md scripts/*.mjs .github/workflows/*.yml",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "cargo test"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.4.1",
    "prettier": "^3.6.2"
  }
}
